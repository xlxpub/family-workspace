# syntax=docker/dockerfile:1
FROM golang:1.21-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/github-webhook ./cmd/github-webhook

FROM alpine:3.19
RUN apk add --no-cache ca-certificates wget util-linux-misc
COPY --from=builder /out/github-webhook /usr/local/bin/github-webhook
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8091/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/github-webhook"]
