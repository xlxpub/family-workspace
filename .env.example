# 使用：cp .env.example .env 然后修改；.env 已被 .gitignore 忽略，切勿提交

# 必填：初始管理员口令 + 脚本 API Token（同时作为 admin 的 Bearer Token）
# 仅首次启动时用于自动创建 admin 账号；之后请在「用户与权限」页改密
FW_AUTH_PASSWORD=change-me-to-a-long-random-password

# 宿主机监听端口（容器内固定 8080）
FW_PORT=8080

# 时区
TZ=Asia/Shanghai

# 仅在 HTTPS 反代时设为 1；内网 http 直连保持 0（否则会话 Cookie 不会发送）
FW_COOKIE_SECURE=0

# 备份保留天数（scripts/backup.sh 使用）
FW_BACKUP_KEEP_DAYS=7
