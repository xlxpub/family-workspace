# 使用：cp .env.example .env 然后修改；.env 已被 .gitignore 忽略，切勿提交

# 必填：初始管理员口令 + 脚本 API Token（同时作为 admin 的 Bearer Token）
# 仅首次启动时用于自动创建 admin 账号；之后请在「用户与权限」页改密
FW_AUTH_PASSWORD=change-me-to-a-long-random-password

# 宿主机监听端口（容器内固定 8080）
FW_PORT=8080

# 宿主机绑定地址：家里同一 WiFi 直连保持 0.0.0.0；
# 云主机走 Caddy 反代时设为 127.0.0.1，让 8080 只对本机可见（公网只开 443）。
FW_BIND=0.0.0.0

# 时区
TZ=Asia/Shanghai

# 仅在 HTTPS 反代时设为 1；内网 http 直连保持 0（否则会话 Cookie 不会发送）
FW_COOKIE_SECURE=0

# 备份保留天数（scripts/backup.sh 使用）
FW_BACKUP_KEEP_DAYS=7

# 可选：一句话记录，兼容 OpenAI Chat Completions；未设置 Key 时关闭
# 原话和必要的成员/模块信息会发往该模型服务，密钥仅在后端使用
# 三个变量必须成对生效：FW_AI_BASE_URL + FW_AI_MODEL + FW_AI_API_KEY
# 官方 DeepSeek：https://api.deepseek.com + deepseek-chat
# 腾讯 TokenHub：https://tokenhub.tencentmaas.com/v1/ + 控制台里的服务 ID（如 deepseek/deepseek-flash）
# 模型 ID 写错时上游返回 400，服务端日志会打印实际生效的 model 与排查提示
FW_AI_BASE_URL=https://api.deepseek.com
FW_AI_MODEL=deepseek-chat
FW_AI_API_KEY=

# 解析失败时把模型原始输出写进服务端日志，便于定位模型返回的形状问题
# 默认 1500 字符（单行、自动剔除密钥）；0 表示关闭
# 注意：该内容可能包含用户原话与家庭记录，日志请按隐私数据处理
FW_AI_LOG_RAW=1500

